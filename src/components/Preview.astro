---
// A live, looping preview of one recipe. With `controls`, adds play/pause, a scrubber and the time.
interface Props {
  slug: string;
  title: string;
  controls?: boolean;
}
const { slug, title, controls = false } = Astro.props;
---

<div class="preview" data-preview data-slug={slug}>
  <svg role="img" aria-label={`${title} animation`}></svg>
  {
    controls && (
      <div class="controls">
        <button class="play" type="button" aria-label="Play or pause">▶</button>
        <input class="seek" type="range" min="0" step="0.01" value="0" aria-label="Scrub" />
        <span class="time" />
      </div>
    )
  }
</div>

<script>
  import { preview } from '../preview.ts';
  document.querySelectorAll<HTMLElement>('[data-preview]').forEach(preview);
</script>

<style>
  .preview svg { display: block; width: 100%; aspect-ratio: 1; background: #000; border-radius: var(--radius); }
  .controls { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-top: 1px solid var(--line); }
  .play {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    font: 600 12px var(--sans);
    color: #000;
    background: #fff;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: var(--glow);
  }
  .seek { flex: 1; min-width: 0; accent-color: #fff; cursor: pointer; }
  .time { color: var(--muted); font: 12px var(--mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
