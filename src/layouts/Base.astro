---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
}
const { title, description } = Astro.props;
const repo = 'https://github.com/Ayush-Dutt-Sharma/easy-animation';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title ? `${title} · easy-animation` : 'easy-animation: copy-paste motion graphics'}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><i aria-hidden="true"></i>easy-animation</a>
        <nav>
          <a href="/#recipes">Recipes</a>
          {/* Breakdowns hidden for now: <a href="/#breakdowns">Breakdowns</a> */}
          <a class="button" href={repo}>★ Star on GitHub</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Recipes are MIT licensed: copy them into anything, including paid work. <a href={repo}>Star it on GitHub</a>.</p>
        <p>Made with <span class="love" aria-label="love">♥</span></p>
      </div>
    </footer>
  </body>
</html>
