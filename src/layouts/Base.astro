---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
}
const { title, description } = Astro.props;
const repo = 'https://github.com/Ayush-Dutt-Sharma/easy-animation';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title ? `${title} · easy-animation` : 'easy-animation: copy-paste motion graphics'}</title>
    {
      /* Vercel Web Analytics: page views, countries, devices, referrers; no cookies. Vercel serves the script, so only in the build. */
      import.meta.env.PROD && (
        <>
          <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
          <script is:inline defer src="/_vercel/insights/script.js"></script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><i aria-hidden="true"></i>easy-animation</a>
        <nav>
          <a href="/#recipes">Recipes</a>
          {/* Breakdowns hidden for now: <a href="/#breakdowns">Breakdowns</a> */}
          <a class="button" href={repo}>★ Star on GitHub</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Recipes are MIT licensed: copy them into anything, including paid work. <a href={repo}>Star it on GitHub</a>.</p>
        <p>Made with <span class="love" aria-label="love">♥</span></p>
        <p class="thanks">
          Thank you, <a href="https://www.youtube.com/@DanKoeTalks/shorts">Dan Koe</a>: your shorts are the inspiration for
          this project.
        </p>
      </div>
    </footer>
  </body>
</html>
